# VAV Terminal Unit -- VAV with reheat
# reference 2018 ashrae guideline 36 section 4.1 
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix constraint: <https://nrel.gov/BuildingMOTIF/constraints#> .
@prefix : <urn:my_site_constraints/> .
@prefix vav42: <urn:ashrae/g36/4.2/vav-with-reheat/> .
@prefix vav41: <urn:ashrae/g36/4.1/vav-cooling-only/> .

: a owl:Ontology ;
    owl:imports <https://brickschema.org/schema/1.3/Brick>,
                <https://nrel.gov/BuildingMOTIF/constraints>,
                <urn:ashrae/g36> .
                
:vav_with_reheat1 a sh:NodeShape ;
    sh:targetClass brick:RVAV ;
    sh:or (vav42:heating-signal1 vav42:heating-signal2) .

:vav_with_reheat2 a sh:NodeShape ;
    sh:targetClass brick:RVAV ;
    sh:node :box-damper-position .

:vav_with_reheat3 a sh:NodeShape ;
    sh:targetClass brick:RVAV ;
    sh:node vav41:zone-temperature .

:vav_with_reheat4 a sh:NodeShape ;
    sh:targetClass brick:RVAV ;
    sh:node vav41:discharge-airflow.

:vav_with_reheat5 a sh:NodeShape ;
    sh:targetClass brick:RVAV ;
    sh:property [
        sh:path brick:hasPoint;
        sh:qualifiedValueShape [ sh:class brick:Supply_Air_Temperature_Sensor ];
        sh:qualifiedMinCount 1;
    ] .

:box-damper-position a sh:NodeShape ;
    sh:or ( :box-damper-position1 :box-damper-position2 ) .

:box-damper-position1 a sh:NodeShape ;
    sh:property [
        sh:path brick:hasPoint ;
        sh:qualifiedValueShape [ sh:class brick:Damper_Position_Command ] ;
        sh:qualifiedMinCount 1 ;
    ] ;
.
:box-damper-position2 a sh:NodeShape ;
    sh:property [
        sh:path brick:hasPart ;
          sh:qualifiedValueShape [ sh:node :damper-with-position ] ;
          sh:qualifiedMinCount 1 ;
    ] ;
.
:damper-with-position a sh:NodeShape;
    sh:class brick:Damper ;
    sh:property [
          sh:path brick:hasPoint ;
          sh:qualifiedValueShape [sh:class brick:Damper_Position_Command ];
          sh:qualifiedMinCount 1;
    ] ;
.