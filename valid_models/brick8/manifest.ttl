# fdd in ahu can be done if you have a couple of sensors in the ahu itself
# reference An expert rule set for fault detection in air-handling units
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix constraint: <https://nrel.gov/BuildingMOTIF/constraints#> .
@prefix : <urn:my_site_constraints/> .

: a owl:Ontology ;
    owl:imports <https://brickschema.org/schema/1.3/Brick> .


:rule-based-fdd a sh:NodeShape;
    sh:targetClass brick:AHU ;
    sh:node :cooling-coil, :heating-coil .

:cooling-coil a sh:NodeShape ;
    sh:property [
        sh:path brick:hasPart ;
        sh:qualifiedValueShape [
            sh:class brick:Cooling_Coil ;
            sh:property [
                sh:path brick:hasPoint ;
                sh:qualifiedValueShape [ sh:class brick:Valve_Command ] ;
                sh:qualifiedMinCount 1 ;
            ] ;
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
    ] ;
.

:heating-coil a sh:NodeShape ;
    sh:property [
        sh:path brick:hasPart ;
        sh:qualifiedValueShape [
            sh:class brick:Heating_Coil ;
            sh:property [
                sh:path brick:hasPoint ;
                sh:qualifiedValueShape [ sh:class brick:Valve_Command ] ;
                sh:qualifiedMinCount 1 ;
            ] ;
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
    ] ;
.