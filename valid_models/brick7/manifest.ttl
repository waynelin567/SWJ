# CO2-concentration based control 
# reference: https://ieeexplore.ieee.org/abstract/document/5553469 
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix constraint: <https://nrel.gov/BuildingMOTIF/constraints#> .
@prefix : <urn:my_site_constraints/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .


: a owl:Ontology ;
    owl:imports <https://brickschema.org/schema/1.3/Brick> .

:ahu_feeds_zone_with_co2_sensor a sh:NodeShape ;
    sh:targetClass brick:Air_Handling_Unit ;
    sh:property [
        sh:path brick:feeds ;
        sh:qualifiedValueShape :co2_zone;
        sh:qualifiedMinCount 1 ;
    ] .

:ahu_with_outside_co2_sensor a sh:NodeShape ;
    sh:targetClass brick:Air_Handling_Unit ;
    sh:property [
        sh:path brick:hasPoint ;
        sh:qualifiedValueShape [sh:node :outside_co2_sensor_with_unit] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
    ] .

:outside_co2_sensor_with_unit a sh:NodeShape ;
    sh:class brick:Outside_Air_CO2_Sensor;
    sh:property [
        sh:path brick:hasUnit;
        sh:hasValue qudt:PPM ;
        sh:minCount 1;
        sh:maxCount 1;
    ] .

:zone_co2_sensor_with_unit a sh:NodeShape ;
    sh:class brick:CO2_Sensor;
    sh:property [
        sh:path brick:hasUnit;
        sh:hasValue qudt:PPM ;
        sh:minCount 1;
        sh:maxCount 1;
    ] .

:Volume a sh:NodeShape;
    sh:nodeKind sh:BlankNode;
    sh:property [
        sh:path brick:value;
        sh:qualifiedValueShape [sh:datatype xsd:decimal];
        sh:qualifiedMinCount 1; 
    ];
    sh:property [
        sh:path brick:hasUnit;
        sh:qualifiedValueShape [sh:hasValue qudt:M3];
        sh:qualifiedMinCount 1;
    ].

:co2_zone a sh:NodeShape;
    sh:class brick:HVAC_Zone ;
    sh:property [
        sh:path brick:volume ;
        sh:qualifiedValueShape :Volume;
        sh:qualifiedMinCount 1;
    ] ;
    sh:property [
        sh:path brick:hasPoint ;
        sh:qualifiedValueShape [sh:node :zone_co2_sensor_with_unit] ;
        sh:qualifiedMinCount 1;
    ] .