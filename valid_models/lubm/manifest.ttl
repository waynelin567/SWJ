:Course a sh:NodeShape;
    sh:class ub:Course ;
    sh:property [
        sh:path ub:name ;
        sh:datatype xsd:string ;
        sh:minCount 1;
        sh:maxCount 1;
    ] .

:Department a sh:NodeShape;
    sh:class ub:Department ;
    sh:property [
        sh:path ub:name;
        sh:datatype xsd:string ;
        sh:minCount 1;
        sh:maxCount 1;
    ] ;
    sh:property [
        sh:path ub:subOrganizationOf;
        sh:qualifiedValueShape [
            sh:node :University
        ] ;
        sh:qualifiedMinCount 1;
        sh:qualifiedMaxCount 1;
    ] .

:FullProfessor a sh:NodeShape;
    sh:targetClass ub:FullProfessor ;
    sh:property [
        sh:path ub:doctoralDegreeFrom;
        sh:qualifiedValueShape [
            sh:node :University
        ] ;
        sh:qualifiedMinCount 1;
        sh:qualifiedMaxCount 1
    ] ;
    sh:property [
        sh:path ub:emailAddress;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path ub:headOf;
        sh:qualifiedValueShape [
            sh:node :Department
        ] ;
        sh:qualifiedMaxCount 1
    ] ;
    sh:property [
        sh:path ub:mastersDegreeFrom;
        sh:qualifiedValueShape [
            sh:node :University
        ] ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path ub:name;
        sh:datatype xsd:string ;
        sh:minCount 1;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ub:researchInterest;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path ub:teacherOf;
        sh:qualifiedValueShape [
            sh:node :Course
        ] ;
        sh:qualifiedMinCount 1;
        sh:qualifiedMaxCount 2
    ] ;
    sh:property [
        sh:path ub:teacherOf;
        sh:qualifiedValueShape [
            sh:node :GraduateCourse
        ] ;
        sh:qualifiedMinCount 1;
        sh:qualifiedMaxCount 2
    ] ;
    sh:property [
        sh:path ub:telephone;
        sh:datatype xsd:string;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path ub:undergraduateDegreeFrom;
        sh:qualifiedValueShape [
            sh:node :University
        ] ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path ub:worksFor;
        sh:qualifiedValueShape [
            sh:node :Department
        ] ;
        sh:qualifiedMinCount 1
    ] .

:GraduateCourse a sh:NodeShape;
    sh:class ub:GraduateCourse ;
    sh:property [
        sh:path ub:name ;
        sh:datatype xsd:string ;
        sh:minCount 1;
        sh:maxCount 1;
    ] .

:GraduateStudent a sh:NodeShape;
    sh:targetClass ub:GraduateStudent ;
    sh:property [
        sh:path ub:advisor ;
        sh:minCount 1;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ub:emailAddress ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path ub:memberOf;
        sh:qualifiedValueShape [
            sh:node :Department
        ] ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path ub:name ;
        sh:datatype xsd:string ;
        sh:minCount 1;
        sh:maxCount 1;
    ] ;
    sh:property [
        sh:path ub:takesCourse;
        sh:qualifiedValueShape [
            sh:node :GraduateCourse
        ] ;
        sh:qualifiedMinCount 1;
        sh:qualifiedMaxCount 3;
    ] ;
    sh:property [
        sh:path ub:teachingAssistantOf;
        sh:qualifiedValueShape [
            sh:node :Course;
        ] ;
        sh:qualifiedMaxCount 1;
    ] ;
    sh:property [
        sh:path ub:telephone;
        sh:datatype xsd:string ;
        sh:minCount 1;
    ] ;
    sh:property [
        sh:path ub:undergraduateDegreeFrom;
        sh:qualifiedValueShape [
            sh:node :University;
        ] ;
        sh:qualifiedMinCount 1;
    ]  .

