:ResearchAssistant a sh:NodeShape;
    sh:targetClass ub:ResearchAssistant ;
    sh:property [
        sh:path ub:advisor ;
        sh:minCount 1;
        sh:maxCount 1;
    ] ;
    sh:property [
        sh:path ub:emailAddress;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path ub:memberOf;
        sh:qualifiedValueShape [
            sh:node :Department
        ] ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path ub:name;
        sh:datatype xsd:string ;
        sh:minCount 1;
        sh:maxCount 1;
    ] ;
    sh:property [
        sh:path ub:takesCourse;
        sh:qualifiedValueShape [
            sh:node :GraduateCourse
        ] ;
        sh:qualifiedMinCount 1;
        sh:qualifiedMaxCount 3;
    ] ;
    sh:property [
        sh:path ub:telephone;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path ub:undergraduateDegreeFrom;
        sh:qualifiedValueShape [
            sh:node :University
        ] ;
        sh:qualifiedMinCount 1
    ] . 

